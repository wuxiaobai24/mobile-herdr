{
  "name": "mobile-herdr",
  "version": "0.2.2-beta.3",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "bridge": "bun run server/index.ts",
    "agent": "bun run scripts/agent.ts",
    "install:agent": "bun run scripts/install-agent.ts",
    "pair": "bun run scripts/pair.ts",
    "start": "bun run scripts/build.ts && bun run server/index.ts",
    "build": "bun run scripts/build.ts",
    "native": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "test:ui": "bun scripts/verify-ui.ts && bun scripts/verify-native-ui.ts && bun scripts/verify-ssh-ui.ts && bun scripts/verify-appearance-ui.ts",
    "test:handoff-live": "bun scripts/verify-handoff-live.ts",
    "release:pack": "bun scripts/release.ts",
    "test:release": "bun scripts/verify-release.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "expo": "~58.0.16",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.2",
    "lucide-react": "0.577.0",
    "lucide-react-native": "^0.577.0",
    "qrcode-terminal": "^0.12.0",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-markdown": "^10.1.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-svg": "^15.15.3",
    "react-native-web": "^0.21.2",
    "react-native-webview": "^13.16.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.49.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  }
}
