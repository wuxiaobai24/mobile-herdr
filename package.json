{
  "name": "mobile-herdr",
  "version": "0.2.2-beta.12",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "bridge": "bun run server/index.ts",
    "service": "bun run scripts/bridge.ts",
    "update": "bun run scripts/update.ts",
    "agent": "bun run scripts/agent.ts",
    "install:agent": "bun run scripts/install-agent.ts",
    "pair": "bun run scripts/pair.ts",
    "token": "bun run scripts/token.ts",
    "start": "bun run scripts/build.ts && bun run server/index.ts",
    "build": "bun run scripts/build.ts",
    "native": "expo start",
    "android": "expo run:android",
    "build:android": "bun scripts/build-android.ts",
    "test:android": "bun scripts/verify-android.ts",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "test:ui": "bun scripts/verify-ui.ts && bun scripts/verify-native-ui.ts && bun scripts/verify-ssh-ui.ts && bun scripts/verify-appearance-ui.ts && bun scripts/verify-experience-ui.ts && bun scripts/verify-mobile-layout.ts && bun scripts/verify-pwa-ui.ts && bun scripts/verify-controls-ui.ts && bun scripts/verify-files-ui.ts && bun scripts/verify-management-ui.ts && bun scripts/verify-navigation-ui.ts && bun scripts/verify-download-ui.ts",
    "test:takeover-live": "bun scripts/verify-takeover-live.ts",
    "test:terminal-live": "bun scripts/verify-terminal-live.ts",
    "test:handoff-live": "bun scripts/verify-handoff-live.ts",
    "release:pack": "bun scripts/release.ts",
    "release:prepare": "bun scripts/prepare-release.ts",
    "release:publish": "bun scripts/publish-release.ts",
    "test:release-public": "python scripts/verify-public-release.py",
    "test:release": "bun scripts/verify-release.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "expo": "~58.0.16",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-dev-client": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-intent-launcher": "~58.0.3",
    "expo-network": "~58.0.4",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.2",
    "expo-system-ui": "~58.0.6",
    "lucide-react": "0.577.0",
    "lucide-react-native": "^0.577.0",
    "qrcode-terminal": "^0.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-svg": "^15.15.3",
    "react-native-web": "^0.21.2",
    "react-native-webview": "14.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/mdast": "^4.0.4",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.49.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  },
  "patchedDependencies": {
    "expo-intent-launcher@58.0.3": "patches/expo-intent-launcher@58.0.3.patch"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-intent-launcher"
        ]
      }
    }
  }
}
